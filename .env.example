# === Telegram (必填才能发消息；缺省时 bot 仍可启动并打警告日志) ===
TELEGRAM_BOT_TOKEN=
# 逗号分隔的 chat id；也可通过 /start 动态订阅写入 SQLite
TELEGRAM_CHAT_IDS=

# === Twitter / X API v2 (缺省时跳过推特扫描) ===
# 至少提供 Bearer Token；也可使用 OAuth 1.0a 用户上下文
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# === GMGN (推荐；CLI 走 GMGN_API_KEY，也可写到 ~/.config/gmgn/.env) ===
GMGN_API_KEY=
# 调用方式: cli (默认, npx gmgn-cli ... --raw) | http (直连 OpenAPI，需自行配置 base url)
GMGN_MODE=cli
GMGN_CLI_BIN=npx
GMGN_CLI_PACKAGE=gmgn-cli
GMGN_HTTP_BASE_URL=https://openapi.gmgn.ai
GMGN_CLI_TIMEOUT_SECONDS=60

# === 扫描与阈值 ===
# 逗号分隔，当前仅 robinhood；后续可加 sol,bsc,base,eth
SCAN_CHAINS=robinhood
SCAN_INTERVAL_SECONDS=30
FOLLOWER_THRESHOLD=10000
ATH_MC_THRESHOLD=800000
BLACKLIST_ALERT_LIMIT=3
TRENCHES_LIMIT=50

# === 运行 ===
DATABASE_PATH=data/bot.db
LOG_LEVEL=INFO
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
# 启动时是否自动开始扫描（true/false）
AUTO_START_SCANNER=true
